    "viewsContainers": {
      "activitybar": [
        {
          "id": "skillfiles",
          "title": "%viewsContainer.skillfiles%",
          "icon": "resources/skillfiles.svg"
        }
      ]
    },
    "views": {
      "skillfiles": [
        {
          "id": "skillfiles.skillsView",
          "name": "%view.skills%",
          "icon": "$(file-code)"
        },
        {
          "id": "skillfiles.repoStatusView",
          "name": "%view.repoStatus%",
          "icon": "$(cloud-upload)"
        },
        {
          "id": "skillfiles.variablesView",
          "name": "%view.variables%",
          "icon": "$(symbol-variable)"
        },
        {
          "id": "skillfiles.historyView",
          "name": "%view.history%",
          "icon": "$(history)"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "skillfiles.skillsView",
        "contents": "%welcome.skills%",
        "when": "skillfiles.noSkills"
      },
      {
        "view": "skillfiles.repoStatusView",
        "contents": "%welcome.repoStatus%",
        "when": "skillfiles.noRepos"
      },
      {
        "view": "skillfiles.historyView",
        "contents": "%welcome.history%",
        "when": "skillfiles.noHistory"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "skillfiles.refreshSkills",
          "when": "view == skillfiles.skillsView",
          "group": "navigation"
        },
        {
          "command": "skillfiles.createSkill",
          "when": "view == skillfiles.skillsView",
          "group": "navigation"
        },
        {
          "command": "skillfiles.discoverSkills",
          "when": "view == skillfiles.skillsView",
          "group": "navigation"
        },
        {
          "command": "skillfiles.scanSharedSkills",
          "when": "view == skillfiles.skillsView",
          "group": "navigation"
        },
        {
          "command": "skillfiles.bulkPush",
          "when": "view == skillfiles.skillsView",
          "group": "2_actions"
        },
        {
          "command": "skillfiles.openAuditLog",
          "when": "view == skillfiles.skillsView",
          "group": "3_tools"
        },
        {
          "command": "skillfiles.refreshRepoStatus",
          "when": "view == skillfiles.repoStatusView",
          "group": "navigation"
        },
        {
          "command": "skillfiles.discoverSkills",
          "when": "view == skillfiles.repoStatusView",
          "group": "navigation"
        },
        {
          "command": "skillfiles.bulkPush",
          "when": "view == skillfiles.repoStatusView",
          "group": "2_actions"
        },
        {
          "command": "skillfiles.bulkCollect",
          "when": "view == skillfiles.repoStatusView",
          "group": "2_actions"
        },
        {
          "command": "skillfiles.setupScanRoots",
          "when": "view == skillfiles.repoStatusView",
          "group": "3_tools"
        },
        {
          "command": "skillfiles.refreshVariables",
          "when": "view == skillfiles.variablesView",
          "group": "navigation"
        },
        {
          "command": "skillfiles.refreshHistory",
          "when": "view == skillfiles.historyView",
          "group": "navigation"
        },
        {
          "command": "skillfiles.clearHistory",
          "when": "view == skillfiles.historyView",
          "group": "2_actions"
        }
      ],
      "view/item/context": [
        {
          "command": "skillfiles.openSkill",
          "when": "view == skillfiles.skillsView && viewItem == skill",
          "group": "1_open"
        },
        {
          "command": "skillfiles.pushSkill",
          "when": "view == skillfiles.skillsView && viewItem == skill",
          "group": "1_open"
        },
        {
          "command": "skillfiles.copySkillPath",
          "when": "view == skillfiles.skillsView && viewItem == skill",
          "group": "2_copy"
        },
        {
          "command": "skillfiles.deleteSkill",
          "when": "view == skillfiles.skillsView && viewItem == skill",
          "group": "3_delete"
        },
        {
          "command": "skillfiles.addTarget",
          "when": "view == skillfiles.skillsView && viewItem == skill",
          "group": "2_copy"
        },
        {
          "command": "skillfiles.manageTargets",
          "when": "view == skillfiles.skillsView && viewItem == skill",
          "group": "2_copy"
        },
        {
          "command": "skillfiles.setCategory",
