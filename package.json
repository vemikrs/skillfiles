    "@vscode/vsce": "^3.7.1",
    "chai": "^6.2.2",
    "esbuild": "^0.27.3",
    "eslint": "^10.0.0",
    "glob": "^13.0.2",
    "mocha": "^11.7.5",
    "nyc": "^17.1.0",
    "ovsx": "^0.10.9",
    "sinon": "^21.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0"
  },
  "dependencies": {
    "handlebars": "^4.7.8",
