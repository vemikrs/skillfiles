          "group": "2_copy"
        },
        {
          "command": "skillfiles.pushSkill",
          "when": "view == skillfiles.skillsView && viewItem == skill",
          "group": "inline"
        },
        {
          "command": "skillfiles.validateSkill",
          "when": "view == skillfiles.skillsView && viewItem == skill",
          "group": "3_validate"
        },
        {
          "command": "skillfiles.pushAllInRepo",
          "when": "view == skillfiles.repoStatusView && viewItem == repo",
          "group": "1_sync"
        },
        {
          "command": "skillfiles.collectAllInRepo",
          "when": "view == skillfiles.repoStatusView && viewItem == repo",
          "group": "1_sync"
        },
        {
          "command": "skillfiles.pushSkill",
          "when": "view == skillfiles.repoStatusView && viewItem =~ /^target/",
          "group": "1_sync"
        },
        {
          "command": "skillfiles.collectSkill",
          "when": "view == skillfiles.repoStatusView && viewItem =~ /^target/",
          "group": "1_sync"
        },
        {
          "command": "skillfiles.showDiff",
          "when": "view == skillfiles.repoStatusView && viewItem =~ /^target/",
          "group": "2_view"
        },
        {
          "command": "skillfiles.openTarget",
          "when": "view == skillfiles.repoStatusView && viewItem =~ /^target/",
          "group": "2_view"
        },
        {
          "command": "skillfiles.copyTargetPath",
          "when": "view == skillfiles.repoStatusView && viewItem =~ /^target/",
          "group": "3_copy"
        },
        {
          "command": "skillfiles.removeTarget",
          "when": "view == skillfiles.repoStatusView && viewItem =~ /^target/",
          "group": "4_delete"
        },
        {
          "command": "skillfiles.pushSkill",
          "when": "view == skillfiles.repoStatusView && viewItem =~ /^target/",
          "group": "inline"
        },
        {
          "command": "skillfiles.collectSkill",
          "when": "view == skillfiles.repoStatusView && viewItem =~ /^target/",
          "group": "inline"
        },
        {
          "command": "skillfiles.rollbackSkill",
          "when": "view == skillfiles.historyView && viewItem == snapshot",
          "group": "1_action"
        },
        {
          "command": "skillfiles.previewSnapshot",
          "when": "view == skillfiles.historyView && viewItem == snapshot",
          "group": "2_view"
        },
        {
          "command": "skillfiles.showSnapshotDiff",
          "when": "view == skillfiles.historyView && viewItem == snapshot",
          "group": "2_view"
        },
        {
          "command": "skillfiles.rollbackSkill",
          "when": "view == skillfiles.historyView && viewItem == snapshot",
          "group": "inline"
        },
        {
          "command": "skillfiles.addResourceFile",
          "when": "view == skillfiles.skillsView && viewItem == skill",
          "group": "4_resource"
        },
        {
          "command": "skillfiles.addResourceFolder",
          "when": "view == skillfiles.skillsView && viewItem == skill",
          "group": "4_resource"
        },
        {
          "command": "skillfiles.revealInFinder",
          "when": "view == skillfiles.skillsView && viewItem == skill",
          "group": "5_reveal"
        },
        {
          "command": "skillfiles.addResourceFile",
          "when": "view == skillfiles.skillsView && viewItem == resourceFolder",
          "group": "1_add"
        },
        {
          "command": "skillfiles.addResourceFolder",
          "when": "view == skillfiles.skillsView && viewItem == resourceFolder",
          "group": "1_add"
        },
        {
          "command": "skillfiles.renameResource",
          "when": "view == skillfiles.skillsView && viewItem =~ /^resource/",
          "group": "2_edit"
        },
        {
          "command": "skillfiles.revealInFinder",
          "when": "view == skillfiles.skillsView && viewItem =~ /^resource/",
          "group": "3_reveal"
        },
        {
          "command": "skillfiles.deleteResource",
          "when": "view == skillfiles.skillsView && viewItem =~ /^resource/",
          "group": "4_delete"
        }
      ]
    },
    "configuration": {
      "title": "Skillfiles",
      "properties": {
        "skillfiles.registryPath": {
          "type": "string",
          "default": "~/.skillfiles",
          "description": "%config.registryPath%"
        },
        "skillfiles.sharedSkillRoot": {
          "type": "string",
          "default": "~",
          "description": "%config.sharedSkillRoot%"
        },
        "skillfiles.scanRoots": {
          "type": "array",
          "default": [],
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "description": "%config.scanRoots.key%"
              },
              "path": {
                "type": "string",
                "description": "%config.scanRoots.path%"
              }
            },
            "required": [
              "key",
              "path"
            ]
          },
          "description": "%config.scanRoots%"
        },
        "skillfiles.scanLimit": {
          "type": "number",
          "default": 200,
          "description": "%config.scanLimit%"
        },
        "skillfiles.autoPushOnSave": {
          "type": "boolean",
          "default": false,
          "description": "%config.autoPushOnSave%"
        },
        "skillfiles.conflictPolicy": {
          "type": "string",
          "enum": [
            "ask",
            "preferRegistry",
            "preferRepo"
          ],
          "default": "ask",
          "description": "%config.conflictPolicy%"
        },
        "skillfiles.dryRun": {
          "type": "boolean",
          "default": false,
          "description": "%config.dryRun%"
        },
        "skillfiles.safeMode": {
          "type": "boolean",
          "default": true,
          "description": "%config.safeMode%"
        },
        "skillfiles.auditLogRetentionDays": {
          "type": "number",
          "default": 90,
          "description": "%config.auditLogRetentionDays%"
        },
        "skillfiles.historyRetentionCount": {
          "type": "number",
          "default": 50,
          "description": "%config.historyRetentionCount%"
        },
        "skillfiles.agentProfiles": {
          "type": "object",
          "default": {
            "agent": {
              "vendor": "agentskills.io",
              "instructionPaths": [
                "AGENTS.md"
              ],
              "skillFolderPath": ".agent/skills",
              "skillFileName": "SKILL.md"
            },
            "gemini": {
              "vendor": "google",
              "instructionPaths": [
                "GEMINI.md",
                ".gemini/styleguide.md"
              ],
              "skillFolderPath": ".gemini/skills",
              "skillFileName": "SKILL.md"
            },
            "antigravity": {
              "vendor": "google",
              "instructionPaths": [
                "GEMINI.md",
                ".gemini/styleguide.md"
              ],
              "skillFolderPath": ".gemini/antigravity/skills",
              "skillFileName": "SKILL.md"
            },
            "copilot": {
              "vendor": "github",
              "instructionPaths": [
                ".github/copilot-instructions.md",
                "AGENTS.md"
              ],
              "skillFolderPath": ".github/skills",
              "skillFileName": "SKILL.md"
            },
            "claude": {
              "vendor": "anthropic",
              "instructionPaths": [
                "CLAUDE.md"
              ],
              "skillFolderPath": ".claude/skills",
              "skillFileName": "SKILL.md"
            },
            "codex": {
              "vendor": "openai",
              "instructionPaths": [
                "AGENTS.md"
              ],
              "skillFolderPath": ".codex/skills",
              "skillFileName": "SKILL.md"
            },
            "cursor": {
              "vendor": "anysphere",
              "instructionPaths": [
                ".cursorrules",
                ".cursor/rules"
              ],
              "skillFolderPath": ".cursor/skills",
              "skillFileName": "SKILL.md"
            },
            "windsurf": {
              "vendor": "codeium",
              "instructionPaths": [
                ".windsurfrules",
                ".windsurf/rules"
              ],
              "skillFolderPath": ".windsurf/skills",
              "skillFileName": "SKILL.md"
            },
            "cody": {
              "vendor": "sourcegraph",
              "instructionPaths": [
                ".cody/instructions.md"
              ],
              "skillFolderPath": ".cody/skills",
              "skillFileName": "SKILL.md"
            },
            "aider": {
              "vendor": "aider",
              "instructionPaths": [
                "CONVENTIONS.md",
                "AGENTS.md"
              ],
              "skillFolderPath": ".aider/skills",
              "skillFileName": "SKILL.md"
            },
            "spring-ai": {
              "vendor": "vmware",
              "instructionPaths": [],
              "skillFolderPath": ".spring-ai/skills",
              "skillFileName": "SKILL.md"
            }
          },
          "description": "%config.agentProfiles%",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "vendor": {
                "type": "string",
                "description": "%config.agentProfiles.vendor%"
              },
              "instructionPaths": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "%config.agentProfiles.instructionPaths%"
              },
              "skillFolderPath": {
                "type": "string",
                "description": "%config.agentProfiles.skillFolderPath%"
              },
              "skillFileName": {
                "type": "string",
                "description": "%config.agentProfiles.skillFileName%"
              }
            }
          }
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run esbuild-base -- --production",
    "esbuild-base": "node esbuild.mjs",
    "esbuild": "pnpm run esbuild-base -- --sourcemap",
    "esbuild-watch": "pnpm run esbuild-base -- --sourcemap --watch",
    "compile": "pnpm run esbuild",
    "compile:test": "node esbuild.mjs --test",
    "typecheck": "tsc -p ./ --noEmit",
    "watch": "pnpm run esbuild-watch",
    "pretest": "pnpm run compile",
    "test": "pnpm run test:unit",
    "test:unit": "mocha 'out/test/unit/**/*.test.js'",
    "test:e2e": "node ./out/test/runTest.js",
    "test:vsix": "node ./out/test/runVsixTest.js",
    "test:coverage": "nyc pnpm run test",
    "lint": "eslint src",
    "package": "vsce package --no-dependencies -o dist/"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chai": "^5.2.3",
