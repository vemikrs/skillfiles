{
  "name": "skillfiles",
  "displayName": "Skillfiles",
  "description": "Centrally manage AI agent skill definitions across repositories",
  "version": "0.1.2",
  "publisher": "ve",
  "license": "MIT",
  "packageManager": "pnpm@10.28.2",
  "icon": "resources/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/vemikrs/skillfiles"
  },
  "bugs": {
    "url": "https://github.com/vemikrs/skillfiles/issues"
  },
  "homepage": "https://github.com/vemikrs/skillfiles#readme",
  "keywords": [
    "ai",
    "agent",
    "copilot",
    "claude",
    "skill",
    "prompt",
    "management"
  ],
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.107.0"
  },
  "categories": [
    "Other",
    "Machine Learning"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "skillfiles.openSkill",
        "title": "Open Skill",
        "category": "Skillfiles",
        "icon": "$(file-code)"
      },
      {
        "command": "skillfiles.createSkill",
        "title": "Create New Skill",
        "category": "Skillfiles",
        "icon": "$(add)"
      },
      {
        "command": "skillfiles.pushSkill",
        "title": "Push Skill to Repository",
        "category": "Skillfiles",
        "icon": "$(repo-push)"
      },
      {
        "command": "skillfiles.collectSkill",
        "title": "Collect Skill from Repository",
        "category": "Skillfiles",
        "icon": "$(repo-pull)"
      },
      {
        "command": "skillfiles.rollbackSkill",
        "title": "Rollback to Snapshot",
        "category": "Skillfiles",
        "icon": "$(history)"
      },
      {
        "command": "skillfiles.previewSnapshot",
        "title": "Preview Snapshot",
        "category": "Skillfiles",
        "icon": "$(preview)"
      },
      {
        "command": "skillfiles.showDiff",
        "title": "Show Diff",
        "category": "Skillfiles",
        "icon": "$(diff)"
      },
      {
        "command": "skillfiles.refreshAll",
        "title": "Refresh All Views",
        "category": "Skillfiles",
        "icon": "$(refresh)"
      },
      {
        "command": "skillfiles.refreshSkills",
        "title": "Refresh Skills",
        "category": "Skillfiles",
        "icon": "$(refresh)"
      },
      {
        "command": "skillfiles.refreshRepoStatus",
        "title": "Refresh Deploy Status",
        "category": "Skillfiles",
        "icon": "$(refresh)"
      },
      {
        "command": "skillfiles.refreshHistory",
        "title": "Refresh History",
        "category": "Skillfiles",
        "icon": "$(refresh)"
      },
      {
        "command": "skillfiles.bulkPush",
        "title": "Bulk Push All Skills",
        "category": "Skillfiles",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "skillfiles.bulkCollect",
        "title": "Bulk Collect All Skills",
        "category": "Skillfiles",
        "icon": "$(cloud-download)"
      },
      {
        "command": "skillfiles.openAuditLog",
        "title": "Open Audit Log",
        "category": "Skillfiles",
        "icon": "$(list-unordered)"
      },
      {
        "command": "skillfiles.setupScanRoots",
        "title": "Setup Scan Roots",
        "category": "Skillfiles",
        "icon": "$(folder-opened)"
      },
      {
        "command": "skillfiles.discoverSkills",
        "title": "Discover Skills from Repositories",
        "category": "Skillfiles",
        "icon": "$(search)"
      },
      {
        "command": "skillfiles.copySkillPath",
        "title": "Copy Skill Path",
        "category": "Skillfiles",
        "icon": "$(clippy)"
      },
      {
        "command": "skillfiles.deleteSkill",
        "title": "Delete Skill",
        "category": "Skillfiles",
        "icon": "$(trash)"
      },
      {
        "command": "skillfiles.copyTargetPath",
        "title": "Copy Target Path",
        "category": "Skillfiles",
        "icon": "$(clippy)"
      },
      {
        "command": "skillfiles.openTarget",
        "title": "Open Target File",
        "category": "Skillfiles",
        "icon": "$(go-to-file)"
      },
      {
        "command": "skillfiles.pushAllInRepo",
        "title": "Push All Skills in Repository",
        "category": "Skillfiles",
        "icon": "$(repo-push)"
      },
      {
        "command": "skillfiles.collectAllInRepo",
        "title": "Collect All Skills in Repository",
        "category": "Skillfiles",
        "icon": "$(repo-pull)"
      },
      {
        "command": "skillfiles.clearHistory",
        "title": "Clear History",
        "category": "Skillfiles",
        "icon": "$(trash)"
      },
      {
        "command": "skillfiles.showSnapshotDiff",
        "title": "Show Snapshot Diff",
        "category": "Skillfiles",
        "icon": "$(diff)"
      },
      {
        "command": "skillfiles.addTarget",
        "title": "Add Target Repository",
        "category": "Skillfiles",
        "icon": "$(add)"
      },
      {
        "command": "skillfiles.removeTarget",
        "title": "Remove Target",
        "category": "Skillfiles",
        "icon": "$(trash)"
      },
      {
        "command": "skillfiles.editVariable",
        "title": "Edit Variable",
        "category": "Skillfiles",
        "icon": "$(edit)"
      },
      {
        "command": "skillfiles.refreshVariables",
        "title": "Refresh Variables",
        "category": "Skillfiles",
        "icon": "$(refresh)"
      },
      {
        "command": "skillfiles.editDefaultVariable",
        "title": "Edit Default Variable",
        "category": "Skillfiles",
        "icon": "$(edit)"
      },
      {
        "command": "skillfiles.editHierarchicalVariable",
        "title": "Edit Variable",
        "category": "Skillfiles",
        "icon": "$(edit)"
      },
      {
        "command": "skillfiles.setCategory",
        "title": "Set Category",
        "category": "Skillfiles",
        "icon": "$(folder)"
      },
      {
        "command": "skillfiles.deleteResource",
        "title": "Delete",
        "category": "Skillfiles",
        "icon": "$(trash)"
      },
      {
        "command": "skillfiles.renameResource",
        "title": "Rename",
        "category": "Skillfiles",
        "icon": "$(edit)"
      },
      {
        "command": "skillfiles.revealInFinder",
        "title": "Reveal in Finder",
        "category": "Skillfiles",
        "icon": "$(folder-opened)"
      },
      {
        "command": "skillfiles.addResourceFile",
        "title": "New File",
        "category": "Skillfiles",
        "icon": "$(new-file)"
      },
      {
        "command": "skillfiles.addResourceFolder",
        "title": "New Folder",
        "category": "Skillfiles",
        "icon": "$(new-folder)"
      },
      {
        "command": "skillfiles.validateSkill",
        "title": "Validate Skill",
        "category": "Skillfiles",
        "icon": "$(check)"
      },
      {
        "command": "skillfiles.validateAllSkills",
        "title": "Validate All Skills",
        "category": "Skillfiles",
        "icon": "$(checklist)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "skillfiles",
          "title": "Skillfiles",
          "icon": "resources/skillfiles.svg"
        }
      ]
    },
    "views": {
      "skillfiles": [
        {
          "id": "skillfiles.skillsView",
          "name": "Skills",
          "icon": "$(file-code)"
        },
        {
          "id": "skillfiles.repoStatusView",
          "name": "Deploy Status",
          "icon": "$(cloud-upload)"
        },
        {
          "id": "skillfiles.variablesView",
          "name": "Variables",
          "icon": "$(symbol-variable)"
        },
        {
          "id": "skillfiles.historyView",
          "name": "History",
          "icon": "$(history)"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "skillfiles.skillsView",
        "contents": "Get Started!\n\n[$(search) Scan Repositories](command:skillfiles.discoverSkills)\nDiscover and import existing skill files\n\n[$(add) Create New Skill](command:skillfiles.createSkill)\n\n[$(folder-opened) Setup Scan Roots](command:skillfiles.setupScanRoots)",
        "when": "skillfiles.noSkills"
      },
      {
        "view": "skillfiles.repoStatusView",
        "contents": "No repositories registered.\n\n[$(search) Scan Repositories](command:skillfiles.discoverSkills)\n\n[$(folder-opened) Setup Scan Roots](command:skillfiles.setupScanRoots)",
        "when": "skillfiles.noRepos"
      },
      {
        "view": "skillfiles.historyView",
        "contents": "No history yet.\n\nSnapshots are automatically saved when you\nPush or Collect skills.",
        "when": "skillfiles.noHistory"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "skillfiles.refreshSkills",
          "when": "view == skillfiles.skillsView",
          "group": "navigation"
        },
        {
          "command": "skillfiles.createSkill",
          "when": "view == skillfiles.skillsView",
          "group": "navigation"
        },
        {
          "command": "skillfiles.discoverSkills",
          "when": "view == skillfiles.skillsView",
          "group": "navigation"
        },
        {
          "command": "skillfiles.bulkPush",
          "when": "view == skillfiles.skillsView",
          "group": "2_actions"
        },
        {
          "command": "skillfiles.openAuditLog",
          "when": "view == skillfiles.skillsView",
          "group": "3_tools"
        },
        {
          "command": "skillfiles.refreshRepoStatus",
          "when": "view == skillfiles.repoStatusView",
          "group": "navigation"
        },
        {
          "command": "skillfiles.discoverSkills",
          "when": "view == skillfiles.repoStatusView",
          "group": "navigation"
        },
        {
          "command": "skillfiles.bulkPush",
          "when": "view == skillfiles.repoStatusView",
          "group": "2_actions"
        },
        {
          "command": "skillfiles.bulkCollect",
          "when": "view == skillfiles.repoStatusView",
          "group": "2_actions"
        },
        {
          "command": "skillfiles.setupScanRoots",
          "when": "view == skillfiles.repoStatusView",
          "group": "3_tools"
        },
        {
          "command": "skillfiles.refreshVariables",
          "when": "view == skillfiles.variablesView",
          "group": "navigation"
        },
        {
          "command": "skillfiles.refreshHistory",
          "when": "view == skillfiles.historyView",
          "group": "navigation"
        },
        {
          "command": "skillfiles.clearHistory",
          "when": "view == skillfiles.historyView",
          "group": "2_actions"
        }
      ],
      "view/item/context": [
        {
          "command": "skillfiles.openSkill",
          "when": "view == skillfiles.skillsView && viewItem == skill",
          "group": "1_open"
        },
        {
          "command": "skillfiles.pushSkill",
          "when": "view == skillfiles.skillsView && viewItem == skill",
          "group": "1_open"
        },
        {
          "command": "skillfiles.copySkillPath",
          "when": "view == skillfiles.skillsView && viewItem == skill",
          "group": "2_copy"
        },
        {
          "command": "skillfiles.deleteSkill",
          "when": "view == skillfiles.skillsView && viewItem == skill",
          "group": "3_delete"
        },
        {
          "command": "skillfiles.addTarget",
          "when": "view == skillfiles.skillsView && viewItem == skill",
          "group": "2_copy"
        },
        {
          "command": "skillfiles.setCategory",
          "when": "view == skillfiles.skillsView && viewItem == skill",
          "group": "2_copy"
        },
        {
          "command": "skillfiles.pushSkill",
          "when": "view == skillfiles.skillsView && viewItem == skill",
          "group": "inline"
        },
        {
          "command": "skillfiles.validateSkill",
          "when": "view == skillfiles.skillsView && viewItem == skill",
          "group": "3_validate"
        },
        {
          "command": "skillfiles.pushAllInRepo",
          "when": "view == skillfiles.repoStatusView && viewItem == repo",
          "group": "1_sync"
        },
        {
          "command": "skillfiles.collectAllInRepo",
          "when": "view == skillfiles.repoStatusView && viewItem == repo",
          "group": "1_sync"
        },
        {
          "command": "skillfiles.pushSkill",
          "when": "view == skillfiles.repoStatusView && viewItem =~ /^target/",
          "group": "1_sync"
        },
        {
          "command": "skillfiles.collectSkill",
          "when": "view == skillfiles.repoStatusView && viewItem =~ /^target/",
          "group": "1_sync"
        },
        {
          "command": "skillfiles.showDiff",
          "when": "view == skillfiles.repoStatusView && viewItem =~ /^target/",
          "group": "2_view"
        },
        {
          "command": "skillfiles.openTarget",
          "when": "view == skillfiles.repoStatusView && viewItem =~ /^target/",
          "group": "2_view"
        },
        {
          "command": "skillfiles.copyTargetPath",
          "when": "view == skillfiles.repoStatusView && viewItem =~ /^target/",
          "group": "3_copy"
        },
        {
          "command": "skillfiles.removeTarget",
          "when": "view == skillfiles.repoStatusView && viewItem =~ /^target/",
          "group": "4_delete"
        },
        {
          "command": "skillfiles.pushSkill",
          "when": "view == skillfiles.repoStatusView && viewItem =~ /^target/",
          "group": "inline"
        },
        {
          "command": "skillfiles.collectSkill",
          "when": "view == skillfiles.repoStatusView && viewItem =~ /^target/",
          "group": "inline"
        },
        {
          "command": "skillfiles.rollbackSkill",
          "when": "view == skillfiles.historyView && viewItem == snapshot",
          "group": "1_action"
        },
        {
          "command": "skillfiles.previewSnapshot",
          "when": "view == skillfiles.historyView && viewItem == snapshot",
          "group": "2_view"
        },
        {
          "command": "skillfiles.showSnapshotDiff",
          "when": "view == skillfiles.historyView && viewItem == snapshot",
          "group": "2_view"
        },
        {
          "command": "skillfiles.rollbackSkill",
          "when": "view == skillfiles.historyView && viewItem == snapshot",
          "group": "inline"
        },
        {
          "command": "skillfiles.addResourceFile",
          "when": "view == skillfiles.skillsView && viewItem == skill",
          "group": "4_resource"
        },
        {
          "command": "skillfiles.addResourceFolder",
          "when": "view == skillfiles.skillsView && viewItem == skill",
          "group": "4_resource"
        },
        {
          "command": "skillfiles.revealInFinder",
          "when": "view == skillfiles.skillsView && viewItem == skill",
          "group": "5_reveal"
        },
        {
          "command": "skillfiles.addResourceFile",
          "when": "view == skillfiles.skillsView && viewItem == resourceFolder",
          "group": "1_add"
        },
        {
          "command": "skillfiles.addResourceFolder",
          "when": "view == skillfiles.skillsView && viewItem == resourceFolder",
          "group": "1_add"
        },
        {
          "command": "skillfiles.renameResource",
          "when": "view == skillfiles.skillsView && viewItem =~ /^resource/",
          "group": "2_edit"
        },
        {
          "command": "skillfiles.revealInFinder",
          "when": "view == skillfiles.skillsView && viewItem =~ /^resource/",
          "group": "3_reveal"
        },
        {
          "command": "skillfiles.deleteResource",
          "when": "view == skillfiles.skillsView && viewItem =~ /^resource/",
          "group": "4_delete"
        }
      ]
    },
    "configuration": {
      "title": "Skillfiles",
      "properties": {
        "skillfiles.registryPath": {
          "type": "string",
          "default": "~/.skillfiles",
          "description": "Path to the skill registry root"
        },
        "skillfiles.sharedSkillRoot": {
          "type": "string",
          "default": "~/.agents",
          "description": "Path to shared skills root"
        },
        "skillfiles.scanRoots": {
          "type": "array",
          "default": [],
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "description": "Unique key for this scan root"
              },
              "path": {
                "type": "string",
                "description": "Absolute path to scan"
              }
            },
            "required": [
              "key",
              "path"
            ]
          },
          "description": "List of scan roots with key-path pairs"
        },
        "skillfiles.scanLimit": {
          "type": "number",
          "default": 200,
          "description": "Maximum number of repositories to scan"
        },
        "skillfiles.autoPushOnSave": {
          "type": "boolean",
          "default": false,
          "description": "Automatically push changes when skill.md is saved"
        },
        "skillfiles.conflictPolicy": {
          "type": "string",
          "enum": [
            "ask",
            "preferRegistry",
            "preferRepo"
          ],
          "default": "ask",
          "description": "Policy for handling conflicts during collect"
        },
        "skillfiles.dryRun": {
          "type": "boolean",
          "default": false,
          "description": "Preview changes without writing files"
        },
        "skillfiles.safeMode": {
          "type": "boolean",
          "default": true,
          "description": "Require confirmation for destructive operations"
        },
        "skillfiles.auditLogRetentionDays": {
          "type": "number",
          "default": 90,
          "description": "Number of days to retain audit logs"
        },
        "skillfiles.historyRetentionCount": {
          "type": "number",
          "default": 50,
          "description": "Number of history snapshots to retain per skill"
        },
        "skillfiles.agentProfiles": {
          "type": "object",
          "default": {
            "gemini": {
              "vendor": "google",
              "instructionPaths": ["GEMINI.md", ".gemini/styleguide.md"],
              "skillFolderPath": ".gemini/skills",
              "skillFileName": "SKILL.md"
            },
            "copilot": {
              "vendor": "github",
              "instructionPaths": [".github/copilot-instructions.md", "AGENTS.md"],
              "skillFolderPath": ".github/skills",
              "skillFileName": "SKILL.md"
            },
            "claude": {
              "vendor": "anthropic",
              "instructionPaths": ["CLAUDE.md"],
              "skillFolderPath": ".claude/skills",
              "skillFileName": "SKILL.md"
            },
            "codex": {
              "vendor": "openai",
              "instructionPaths": ["AGENTS.md"],
              "skillFolderPath": ".agents/skills",
              "skillFileName": "SKILL.md"
            },
            "cursor": {
              "vendor": "anysphere",
              "instructionPaths": [".cursorrules", ".cursor/rules"],
              "skillFolderPath": ".cursor/skills",
              "skillFileName": "SKILL.md"
            },
            "windsurf": {
              "vendor": "codeium",
              "instructionPaths": [".windsurfrules", ".windsurf/rules"],
              "skillFolderPath": ".windsurf/skills",
              "skillFileName": "SKILL.md"
            },
            "cody": {
              "vendor": "sourcegraph",
              "instructionPaths": [".cody/instructions.md"],
              "skillFolderPath": ".cody/skills",
              "skillFileName": "SKILL.md"
            },
            "aider": {
              "vendor": "aider",
              "instructionPaths": ["CONVENTIONS.md", "AGENTS.md"],
              "skillFolderPath": ".aider/skills",
              "skillFileName": "SKILL.md"
            },
            "spring-ai": {
              "vendor": "vmware",
              "instructionPaths": [],
              "skillFolderPath": ".spring-ai/skills",
              "skillFileName": "SKILL.md"
            }
          },
          "description": "Agent-specific file path configurations. Each agent can have instructionPaths (for reference), skillFolderPath, and skillFileName.",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "vendor": {
                "type": "string",
                "description": "Vendor name"
              },
              "instructionPaths": {
                "type": "array",
                "items": { "type": "string" },
                "description": "Instruction file paths (not managed by Skillfiles)"
              },
              "skillFolderPath": {
                "type": "string",
                "description": "Folder path where skills are deployed"
              },
              "skillFileName": {
                "type": "string",
                "description": "Skill file name pattern"
              }
            }
          }
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run esbuild-base -- --production",
    "esbuild-base": "node esbuild.mjs",
    "esbuild": "pnpm run esbuild-base -- --sourcemap",
    "esbuild-watch": "pnpm run esbuild-base -- --sourcemap --watch",
    "compile": "pnpm run esbuild",
    "compile:test": "node esbuild.mjs --test",
    "typecheck": "tsc -p ./ --noEmit",
    "watch": "pnpm run esbuild-watch",
    "pretest": "pnpm run compile",
    "test": "pnpm run test:unit",
    "test:unit": "mocha 'out/test/unit/**/*.test.js'",
    "test:e2e": "node ./out/test/runTest.js",
    "test:vsix": "node ./out/test/runVsixTest.js",
    "test:coverage": "nyc pnpm run test",
    "lint": "eslint src",
    "package": "vsce package --no-dependencies -o dist/"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/chai": "^5.2.3",
    "@types/js-yaml": "^4.0.9",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.2.0",
    "@types/sinon": "^21.0.0",
    "@types/vscode": "^1.107.0",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.7.1",
    "chai": "^6.2.2",
    "esbuild": "^0.27.2",
    "eslint": "^9.39.2",
    "glob": "^13.0.1",
    "mocha": "^11.7.5",
    "nyc": "^17.1.0",
    "ovsx": "^0.10.8",
    "sinon": "^21.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0"
  },
  "dependencies": {
    "@types/minimatch": "^6.0.0",
    "handlebars": "^4.7.8",
    "js-yaml": "^4.1.1",
    "minimatch": "^10.1.2"
  }
}
