{
  "name": "skillfiles",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.1.19",
  "publisher": "ve",
  "license": "MIT",
  "packageManager": "pnpm@10.28.2",
  "icon": "resources/icon.png",
  "l10n": "./l10n",
  "repository": {
    "type": "git",
    "url": "https://github.com/vemikrs/skillfiles"
  },
  "bugs": {
    "url": "https://github.com/vemikrs/skillfiles/issues"
  },
  "homepage": "https://github.com/vemikrs/skillfiles#readme",
